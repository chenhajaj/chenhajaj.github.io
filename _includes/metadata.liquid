{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!--
  Content security policy: only this site's own files, plus Google Analytics.
  GitHub Pages cannot send headers, so it is set here as a meta tag.
-->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
>
<meta name="referrer" content="strict-origin-when-cross-origin">
{%- if page.robots %}<meta name="robots" content="{{ page.robots }}">{% endif %}
<title>
  {% if site.title == 'blank' %}
    {% capture title %}{{ author_name }}{% endcapture %}
  {% else %}
    {% capture title %}{{ site.title }}{% endcapture %}
  {% endif %}
  {% if page.url == '/blog/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page.title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{% if page.description %}{{ page.description }}{% else %}{{ site.description }}{% endif %}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% assign so = site.data.socials %}
{% if page.url == '/' %}
  {% assign share_title = title %}
{% else %}
  {% capture share_title %}{{ page.title }} | {{ title }}{% endcapture %}
{% endif %}
{% assign share_desc = page.description | default: site.description | strip_newlines | strip %}
{% assign share_image = page.og_image | default: site.og_image %}
{% capture share_image_url %}{{ share_image | prepend: site.baseurl | prepend: site.url }}{% endcapture %}
{% capture canonical_url %}{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}{% endcapture %}

{% if site.serve_og_meta %}
  <!-- Link previews (Open Graph and X/Twitter) -->
  <meta property="og:site_name" content="{{ title }}">
  <meta
    property="og:type"
    content="{% if page.layout == 'post' or page.layout == 'note' %}article{% elsif page.url == '/' %}profile{% else %}website{% endif %}"
  >
  <meta property="og:title" content="{{ share_title | strip }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ share_desc }}">
  {% if share_image %}
    <meta property="og:image" content="{{ share_image_url }}">
    <meta property="og:image:width" content="{{ page.og_image_width | default: 1200 }}">
    <meta property="og:image:height" content="{{ page.og_image_height | default: 630 }}">
    <meta property="og:image:alt" content="{{ page.og_image_alt | default: 'Chen Hajaj, Adaptive AI Lab, Ariel University' }}">
  {% endif %}
  <meta property="og:locale" content="en_US">
  {% if page.url == '/' %}
    <meta property="profile:first_name" content="{{ site.first_name }}">
    <meta property="profile:last_name" content="{{ site.last_name }}">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ share_title | strip }}">
  <meta name="twitter:description" content="{{ share_desc }}">
  {% if share_image %}
    <meta name="twitter:image" content="{{ share_image_url }}">
    <meta name="twitter:image:alt" content="{{ page.og_image_alt | default: 'Chen Hajaj, Adaptive AI Lab, Ariel University' }}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Structured data (schema.org) -->
  {% capture person_json %}
  {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": {{ author_name | strip | jsonify }},
    "url": "{{ site.url }}/",
    "image": "{{ '/assets/img/me.jpeg' | prepend: site.url }}",
    "jobTitle": "Associate Professor of Industrial Engineering and Management",
    "email": "mailto:{{ so.email }}",
    "affiliation": { "@type": "CollegeOrUniversity", "name": "Ariel University", "url": "https://www.ariel.ac.il/" },
    "alumniOf": [{ "@type": "CollegeOrUniversity", "name": "Bar-Ilan University" }, { "@type": "CollegeOrUniversity", "name": "Vanderbilt University" }],
    "knowsAbout": ["Machine learning", "Encrypted traffic classification", "Adversarial machine learning", "Network security", "Medical data science", "Mechanism design", "Multimodal AI", "Speaker diarization"],
    "sameAs": [
      "https://scholar.google.com/citations?user={{ so.scholar_userid }}",
      "https://orcid.org/{{ so.orcid_id }}",
      "{{ so.dblp_url }}",
      "https://www.linkedin.com/in/{{ so.linkedin_username }}",
      "https://github.com/{{ so.github_username }}",
      "{{ so.research_gate_profile }}",
      "{{ so.scopus_id }}",
      "https://www.semanticscholar.org/author/{{ so.semanticscholar_id }}"
    ]
  }
  {% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {{ person_json }},
        {
          "@type": "{% if page.layout == 'post' or page.layout == 'note' %}Article{% elsif page.url == '/' %}ProfilePage{% else %}WebPage{% endif %}",
          "@id": "{{ canonical_url }}#page",
          "url": "{{ canonical_url }}",
          "name": {{ share_title | strip | jsonify }},
          "description": {{ share_desc | jsonify }},
          {% if page.layout == 'post' or page.layout == 'note' %}"datePublished": "{{ page.date | date_to_xmlschema }}", "headline": {{ page.title | default: share_title | strip | jsonify }}, "author": { "@id": "{{ site.url }}/#person" },{% endif %}
          {% if page.url == '/' %}"mainEntity": { "@id": "{{ site.url }}/#person" },{% else %}"about": { "@id": "{{ site.url }}/#person" },{% endif %}
          "isPartOf": { "@type": "WebSite", "name": {{ title | strip | jsonify }}, "url": "{{ site.url }}/" }
        }
      ]
    }
  </script>
{% endif %}
