{%- comment -%}
  A short stat line beside a page title, for numbers the page does not
  already state elsewhere (Publications, News and the Lab show theirs in the
  filters or the intro). Pages without one render nothing.
{%- endcomment -%}
{%- assign r = site.data.research -%}
{%- capture glance -%}
  {%- case page.url -%}
    {%- when '/projects/' -%}
      <div><dt>refereed papers</dt><dd class="num">{{ r.refereed }}</dd></div>
      <div><dt>co-authors</dt><dd class="num">{{ r.collaborators }}</dd></div>
    {%- when '/software/' -%}
      {%- assign repo_count = 0 -%}
      {%- for group in page.groups -%}
        {%- assign repo_count = repo_count | plus: site.data.repositories.repos[group.key].size -%}
      {%- endfor -%}
      <div><dt>repositories</dt><dd class="num">{{ repo_count }}</dd></div>
      <div><dt>topics</dt><dd class="num">{{ page.groups.size }}</dd></div>
  {%- endcase -%}
{%- endcapture -%}
{%- assign glance = glance | strip -%}
{%- if glance != '' -%}
  <dl class="page-glance">{{ glance }}</dl>
{%- endif -%}
