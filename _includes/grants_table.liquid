{%- comment -%} Research grants from _data/grants.yml {%- endcomment -%}
<div class="table-scroll">
  <table class="data-table stack">
    <thead>
      <tr>
        <th scope="col">Year</th>
        <th scope="col">Grant</th>
        <th scope="col">Role</th>
        <th scope="col" class="amount">Amount</th>
      </tr>
    </thead>
    <tbody>
      {%- for grant in site.data.grants.grants -%}
        <tr>
          <td class="num">{{ grant.year }}</td>
          <td class="title-cell">
            {{ grant.full_name }}
            <span class="sub">{{ grant.organization }}</span>
          </td>
          <td class="role">
            {% if grant.role == 'PI' %}PI{% else %}Co-PI{% endif %}
          </td>
          <td class="amount">
            {%- if grant.currency == 'NIS' -%}₪{%- else -%}${%- endif -%}
            {{- grant.amount | thousands -}}
          </td>
        </tr>
      {%- endfor -%}
    </tbody>
    {%- assign total_nis = 0 -%}
    {%- assign total_usd = 0 -%}
    {%- for grant in site.data.grants.grants -%}
      {%- if grant.currency == 'NIS' -%}{%- assign total_nis = total_nis | plus: grant.amount -%}{%- else -%}{%- assign total_usd = total_usd | plus: grant.amount -%}{%- endif -%}
    {%- endfor -%}
    <tfoot>
      <tr>
        <td colspan="3">Total</td>
        <td class="amount">₪{{ total_nis | thousands }}<br>${{ total_usd | thousands }}</td>
      </tr>
    </tfoot>
  </table>
</div>
