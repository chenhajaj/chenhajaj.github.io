{%- comment -%}
  Research grants from _data/grants.yml as a bar chart. Bars are scaled within
  each currency (no conversion), coloured by research line; co-PI grants are
  striped. Every number is also printed as text.
{%- endcomment -%}
{%- assign all = site.data.grants.grants -%}
{%- assign groups = 'NIS,USD' | split: ',' -%}
<div class="grant-chart">
  <div class="grant-totals">
    {%- for cur in groups -%}
      {%- assign list = all | where: 'currency', cur -%}
      {%- assign total = 0 -%}
      {%- for g in list -%}
        {%- assign total = total | plus: g.amount -%}
      {%- endfor -%}
      <p class="grant-total">
        <span class="grant-total-num num">
          {%- if cur == 'NIS' %}₪{% else %}${% endif -%}
          {{- total | thousands -}}
        </span>
        <span class="grant-total-label">
          {{- list.size }} grants in {% if cur == 'NIS' %}shekels{% else %}US dollars{% endif -%}
        </span>
      </p>
    {%- endfor -%}
    <p class="grant-key">
      <span><span class="grant-swatch" aria-hidden="true"></span>PI</span>
      <span><span class="grant-swatch is-co" aria-hidden="true"></span>Co-PI</span>
    </p>
  </div>
  {%- for cur in groups -%}
    {%- assign list = all | where: 'currency', cur | sort: 'amount' | reverse -%}
    {%- assign max = list.first.amount -%}
    <ol class="grant-bars" aria-label="Grants in {% if cur == 'NIS' %}shekels{% else %}US dollars{% endif %}">
      {%- for g in list -%}
        {%- assign w = g.amount | times: 100 | divided_by: max -%}
        <li class="grant-row" style="--c: var(--line-{{ g.line | default: 'other' }}); --w: {{ w }}%; --i: {{ forloop.index0 }}">
          <div class="grant-label">
            <p class="grant-name">{{ g.full_name }}</p>
            <p class="grant-meta">
              <span class="num">{{ g.year }}</span> · {{ g.organization }} · {% if g.role == 'PI' %}PI{% else %}Co-PI{% endif %}
            </p>
          </div>
          <div class="grant-track">
            <span class="grant-fill{% if g.role != 'PI' %} is-co{% endif %}"></span>
            <span class="grant-amount num">
              {%- if cur == 'NIS' %}₪{% else %}${% endif -%}
              {{- g.amount | thousands -}}
            </span>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  {%- endfor -%}
</div>
