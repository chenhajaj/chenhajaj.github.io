{% assign nav = site.data.navigation %}
<header class="site-header" id="site-header">
  <div class="wrap">
    <a class="wordmark" href="{{ '/' | relative_url }}">
      {{- site.first_name }}
      {{ site.last_name -}}
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {% for item in nav %}
          {% assign is_current = false %}
          {% if page.url == item.url %}
            {% assign is_current = true %}
          {% elsif item.url != '/' and page.url contains item.url %}
            {% assign is_current = true %}
          {% elsif item.also %}
            {% for extra in item.also %}
              {% if page.url contains extra %}{% assign is_current = true %}{% endif %}
            {% endfor %}
          {% endif %}
          <li>
            <a
              href="{{ item.url | relative_url }}"
              {% if is_current %}
                aria-current="page"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-toggle">Menu</button>

    <button class="icon-button theme-toggle" type="button" id="theme-toggle" aria-label="Switch colour theme">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke-linecap="round"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>
