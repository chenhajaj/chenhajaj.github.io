{%- comment -%}
  The lab, year by year: a scroll-driven replay of the paper map (assets/js/story.js).
  The panel holds still while the visitor scrolls; the year runs from the first
  paper to now, squares land column by column, counters climb and captions mark
  milestones (from _data/career.yml, plus the first paper in each research line).
  Without motion (or JavaScript) it shows the finished picture.
{%- endcomment -%}
{%- assign r = site.data.research -%}
{%- assign grads = site.data.students.phd_alumni.size | plus: site.data.students.masters_alumni.size -%}
<section class="story" aria-labelledby="story-title" data-story>
  <div class="story-pin">
    <div class="wrap story-inner">
      <div class="story-text">
        <h2 class="story-kicker" id="story-title">The lab, year by year</h2>
        <p class="story-year num" aria-hidden="true">{{ 'now' | date: '%Y' }}</p>
        <dl class="story-counters" aria-hidden="true">
          <div>
            <dt>Papers</dt>
            <dd class="num" data-count="papers">{{ r.papers }}</dd>
          </div>
          <div>
            <dt>Co-authors</dt>
            <dd class="num" data-count="people">{{ r.collaborators }}</dd>
          </div>
          <div>
            <dt>Graduates</dt>
            <dd class="num" data-count="grads">{{ grads }}</dd>
          </div>
        </dl>
        <ol class="story-captions" aria-hidden="true"></ol>
        <p class="visually-hidden">
          From {{ r.first_year }} to today: {{ r.papers }} papers with {{ r.collaborators }} co-authors across seven research lines, and
          {{ grads }} graduate students.
        </p>
        <p class="story-hint" aria-hidden="true">Keep scrolling</p>
      </div>
      <div class="story-map" aria-hidden="true">
        <canvas></canvas>
      </div>
    </div>
  </div>
  <script type="application/json" id="story-milestones">
    [
      {%- for m in site.data.career.milestones -%}
        { "year": {{ m.year }}, "text": {{ m.lines.first | jsonify }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>
