{%- assign so = site.data.socials -%}
{%- assign email = so.email | default: 'chenha@g.ariel.ac.il' -%}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <address>
        <p class="footer-name">
          {{ site.first_name }}
          {{ site.last_name }}
        </p>
        <p>
          Associate Professor, Industrial Engineering and Management<br>
          Ariel University, Ariel, Israel
        </p>
        <p>
          Building 58, floor 3, office 42<br>
          <a href="mailto:{{ email }}">{{ email }}</a>
        </p>
      </address>
      <nav aria-labelledby="footer-site-head">
        <p class="footer-head" id="footer-site-head">On this site</p>
        <ul class="footer-links">
          {%- comment -%} Same order as the main navigation (_data/navigation.yml). {%- endcomment %}
          <li><a href="{{ '/projects/' | relative_url }}">Research</a></li>
          <li><a href="{{ '/publications/' | relative_url }}">Publications</a></li>
          <li><a href="{{ '/software/' | relative_url }}">Code and software</a></li>
          <li><a href="{{ '/people/' | relative_url }}">Lab</a></li>
          <li><a href="{{ '/teaching/' | relative_url }}">Teaching</a></li>
          <li><a href="{{ '/insights/' | relative_url }}">Explainers</a></li>
          <li><a href="{{ '/news/' | relative_url }}">News</a></li>
          <li><a href="{{ '/cv/' | relative_url }}">CV</a></li>
          <li><a href="{{ '/contact/' | relative_url }}">Contact</a></li>
          <li><a href="{{ '/feed.xml' | relative_url }}">Feed</a></li>
          <li><a href="{{ '/accessibility/' | relative_url }}">Accessibility</a></li>
          <li><a href="{{ '/privacy/' | relative_url }}">Privacy</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-profiles-head">
        <p class="footer-head" id="footer-profiles-head">Profiles</p>
        <ul class="footer-links">
          <li><a href="https://scholar.google.com/citations?user={{ so.scholar_userid }}">Google Scholar</a></li>
          <li><a href="https://github.com/{{ so.github_username }}">GitHub</a></li>
          <li><a href="https://orcid.org/{{ so.orcid_id }}">ORCID</a></li>
          <li><a href="{{ so.dblp_url }}">DBLP</a></li>
          <li><a href="https://www.linkedin.com/in/{{ so.linkedin_username }}">LinkedIn</a></li>
          <li><a href="{{ so.research_gate_profile }}">ResearchGate</a></li>
          <li><a href="https://www.semanticscholar.org/author/{{ so.semanticscholar_id }}">Semantic Scholar</a></li>
          <li><a href="{{ so.scopus_id }}">Scopus</a></li>
        </ul>
      </nav>
    </div>
    <p class="footer-meta">
      © {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.last_name }}. Updated {{ site.time | date: '%-d %B %Y' }}. Fonts: Archivo and Source Serif 4,
      <a href="https://openfontlicense.org/">SIL Open Font License</a>.
    </p>
  </div>
</footer>
