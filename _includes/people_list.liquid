<ul class="people-cols">
  {%- for p in include.people -%}
    <li class="person">
      <p class="person-name">
        {%- if p.link -%}
          <a href="{{ p.link }}">{{ p.name }}</a>
        {%- else -%}
          {{ p.name }}
        {%- endif -%}
      </p>
      <p class="person-topic">{{ p.research_area | strip }}</p>
      {%- if p.program == 'project' -%}
        <p class="person-extra">
          Non-thesis MSc, final project{% if p.institution %}, {{ p.institution }}{% endif %}
        </p>
      {%- elsif p.institution -%}
        <p class="person-extra">{{ p.institution }}</p>
      {%- endif -%}
      {%- if p.co_supervisor or p.start_year -%}
        <p class="person-extra">
          {%- if p.start_year -%}Since {{ p.start_year }}{%- endif -%}
          {%- if p.start_year and p.co_supervisor -%}. {% endif -%}
          {%- if p.co_supervisor -%}Co-supervised with {{ p.co_supervisor }}{%- endif -%}
        </p>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
