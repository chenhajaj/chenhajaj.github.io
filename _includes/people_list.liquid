{%- comment -%}
  Current students as cards: initials in the colour of their research line
  (from research-data.rb: the line they publish in most, else their topic).
{%- endcomment -%}
<ul class="person-cards">
  {%- for p in include.people -%}
    {%- assign key = site.data.research.student_line[p.name] | default: 'other' -%}
    {%- assign ln = site.data.research_lines.lines | where: 'key', key | first -%}
    <li class="person-card">
      {% include avatar.liquid name=p.name line=key size="lg" %}
      <div class="person-body">
        <p class="person-name">
          {%- if p.link -%}
            <a href="{{ p.link }}">{{ p.name }}</a>
          {%- else -%}
            {{ p.name }}
          {%- endif -%}
        </p>
        <p class="person-topic">{{ p.research_area | strip }}</p>
        <p class="person-extra">
          {%- if ln -%}
            <span class="line-tag" style="--c: var(--line-{{ key }})"><span class="line-dot" aria-hidden="true"></span>{{ ln.name }}</span>
          {%- endif -%}
          {%- if p.program == 'project' -%}
            <span
              >Non-thesis MSc{% if p.institution %}, {{ p.institution }}{% endif -%}
            </span>
          {%- elsif p.institution -%}
            <span>{{ p.institution }}</span>
          {%- endif -%}
          {%- if p.start_year -%}
            <span>Since {{ p.start_year }}</span>
          {%- endif -%}
          {%- if p.co_supervisor -%}
            <span>Co-supervised with {{ p.co_supervisor }}</span>
          {%- endif -%}
        </p>
      </div>
    </li>
  {%- endfor -%}
</ul>
