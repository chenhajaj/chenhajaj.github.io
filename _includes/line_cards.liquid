{%- comment -%}
  Research line cards. Colour, paper count and the data cover (the line's
  slice of the paper map, inline SVG) come from site.data.research (built
  from papers.bib by _plugins/research-data.rb). Under 640px the cards become
  compact rows (_sass/signal/_covers.scss).
  include params: level (heading level, default 3), outcome (true to show it)
{%- endcomment -%}
{%- assign level = include.level | default: 3 -%}
{%- assign r = site.data.research -%}
{%- assign projects = site.projects | sort: 'importance' -%}
<ul class="line-cards">
  {%- for project in projects -%}
    {%- assign slug = project.url | split: '/' | last -%}
    {%- assign line = r.by_project[slug] -%}
    {%- assign key = line.key | default: 'other' -%}
    <li>
      <a class="line-card" href="{{ project.url | relative_url }}" style="--c: var(--line-{{ key }})">
        {%- if line -%}
          {% include line_cover.liquid line=line slug=slug class='line-card-cover' %}
        {%- endif -%}
        <div class="line-card-body">
          <h{{ level }} class="line-card-title">{{ project.title }}</h{{ level }}>
          <p class="line-card-desc">{{ project.description }}</p>
          {%- if include.outcome and project.outcome -%}
            <p class="line-card-outcome">{{ project.outcome }}</p>
          {%- endif -%}
        </div>
        {%- if line -%}
          <p class="line-card-foot line-card-count">
            <strong class="num">{{ line.count }}</strong> papers,
            {% if line.first == line.last %}{{ line.first }}{% else %}{{ line.first }} to {{ line.last }}{% endif -%}
          </p>
        {%- endif -%}
      </a>
    </li>
  {%- endfor -%}
</ul>
