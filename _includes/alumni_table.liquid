{%- comment -%}
  Alumni as a compact wall of cards (initials in their research-line colour,
  year, topic). Kept under the old include name so pages need no change.
{%- endcomment -%}
<h3 class="subhead">
  {{ include.title }}
  <span class="count">{{ include.people | size }}</span>
</h3>
<ul class="alumni-cards">
  {%- for p in include.people -%}
    {%- assign key = site.data.research.student_line[p.name] | default: 'other' -%}
    <li class="alumni-card">
      {% include avatar.liquid name=p.name line=key %}
      <div class="person-body">
        <p class="person-name">
          {%- if p.link -%}
            <a href="{{ p.link }}">{{ p.name }}</a>
          {%- else -%}
            {{ p.name }}
          {%- endif -%}
          {%- if p.graduation_year -%}
            <span class="alumni-year num">{{ p.graduation_year }}</span>
          {%- endif -%}
        </p>
        {%- if p.research_area -%}
          <p class="person-topic">{{ p.research_area | strip }}</p>
        {%- endif -%}
        {%- if p.institution -%}
          <p class="person-extra">
            <span>{{ p.institution }}</span>
          </p>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
