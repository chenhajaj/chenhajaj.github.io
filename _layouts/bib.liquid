---
---
{%- comment -%}
  One publication, rendered by jekyll-scholar. Used by the publications page,
  the home page "Selected papers" list and the per-project paper lists.
  data-kind feeds the type filter; data-lines feeds the research-line filter;
  data-line (the first matching line) sets the colour of the square.
{%- endcomment -%}
{%- assign venue_text = entry.howpublished | append: ' ' | append: entry.note | downcase -%}
{%- case entry.type -%}
  {%- when 'article' -%}
    {%- assign kind = 'journal' -%}
    {%- assign kind_label = 'Journal' -%}
  {%- when 'inproceedings' -%}
    {%- assign kind = 'conference' -%}
    {%- assign kind_label = 'Conference' -%}
  {%- when 'phdthesis', 'mastersthesis' -%}
    {%- assign kind = 'thesis' -%}
    {%- assign kind_label = 'Thesis' -%}
  {%- when 'book' -%}
    {%- assign kind = 'book' -%}
    {%- assign kind_label = 'Book' -%}
  {%- else -%}
    {%- if venue_text contains 'patent' -%}
      {%- assign kind = 'patent' -%}
      {%- assign kind_label = 'Patent' -%}
    {%- elsif venue_text contains 'abstract' -%}
      {%- assign kind = 'abstract' -%}
      {%- assign kind_label = 'Abstract' -%}
    {%- elsif venue_text contains 'preprint' or venue_text contains 'working paper' or venue_text contains 'arxiv' or venue_text contains 'ssrn' -%}
      {%- assign kind = 'preprint' -%}
      {%- assign kind_label = 'Preprint' -%}
    {%- else -%}
      {%- assign kind = 'other' -%}
      {%- assign kind_label = 'Other' -%}
    {%- endif -%}
{%- endcase -%}
{%- comment -%}
  An explicit `category` field in papers.bib overrides the guess above
  (same rule as _plugins/research-data.rb).
{%- endcomment -%}
{%- if entry.category -%}
  {%- assign kind = entry.category | downcase -%}
  {%- case kind -%}
    {%- when 'workshop' -%}
      {%- assign kind_label = 'Workshop' -%}
    {%- when 'conference' -%}
      {%- assign kind_label = 'Conference' -%}
    {%- when 'journal' -%}
      {%- assign kind_label = 'Journal' -%}
    {%- else -%}
      {%- assign kind_label = kind | capitalize -%}
  {%- endcase -%}
{%- endif -%}
{%- comment -%}
  Research line: the first line in _data/research_lines.yml whose tags
  appear in the entry's `projects` field (same rule as _plugins/research-data.rb).
{%- endcomment -%}
{%- assign ptags = entry.projects | downcase -%}
{%- assign line_keys = '' -%}
{%- assign primary = 'other' -%}
{%- assign primary_name = site.data.research_lines.other.name -%}
{%- for l in site.data.research_lines.lines -%}
  {%- assign hit = false -%}
  {%- for t in l.tags -%}
    {%- if ptags contains t -%}{%- assign hit = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if hit -%}
    {%- assign line_keys = line_keys | append: l.key | append: ',' -%}
    {%- if primary == 'other' -%}
      {%- assign primary = l.key -%}
      {%- assign primary_name = l.name -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if entry.doi -%}
  {%- capture main_url -%}https://doi.org/{{ entry.doi }}{%- endcapture -%}
{%- elsif entry.url -%}
  {%- assign main_url = entry.url -%}
{%- elsif entry.pdf -%}
  {%- assign main_url = entry.pdf -%}
{%- else -%}
  {%- assign main_url = null -%}
{%- endif -%}
<article
  class="pub"
  id="pub-{{ entry.key }}"
  {%- comment -%} Short papers, workshop papers and abstracts share one filter group. {%- endcomment -%}
  {%- if kind == 'workshop' or kind == 'abstract' -%}
    {%- assign filter_kind = 'short' -%}
  {%- else -%}
    {%- assign filter_kind = kind -%}
  {%- endif %}
  data-kind="{{ filter_kind }}"
  data-year="{{ entry.year }}"
  data-projects="{{ entry.projects | remove: ' ' }}"
  data-line="{{ primary }}"
  style="--c: var(--line-{{ primary }})"
  data-lines="{{ line_keys }}"
  {% if entry.selected %}
    data-selected="true"
  {% endif %}
>
  <h3 class="pub-title">
    <span
      class="pub-mark{% if entry.selected %} is-selected{% endif %}"
      style="--c: var(--line-{{ primary }})"
      title="{{ primary_name }}{% if entry.selected %}, selected publication{% endif %}"
      aria-hidden="true"
    ></span>
    {%- if entry.selected -%}
      <span class="visually-hidden">Selected: </span>
    {%- endif -%}
    {%- if main_url -%}
      <a href="{{ main_url }}">{{ entry.title }}</a>
    {%- else -%}
      {{ entry.title }}
    {%- endif -%}
  </h3>

  <p class="pub-authors">
    {%- assign n = entry.author_array | size -%}
    {%- for author in entry.author_array -%}
      {%- assign last_clean = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      {%- assign is_me = false -%}
      {%- if site.scholar.last_name contains last_clean and site.scholar.first_name contains author.first -%}{%- assign is_me = true -%}{%- endif -%}
      {%- if forloop.first == false -%}
        {%- if forloop.last -%}
          {%- if n > 2 -%},{%- endif %} and
        {% else -%}
          ,
        {% endif -%}
      {%- endif -%}
      {%- if is_me -%}
        <strong class="me">
          {{- author.first }}
          {{ last_clean -}}
        </strong>
      {%- else -%}
        {{ author.first }}
        {{ last_clean }}
      {%- endif -%}
    {%- endfor -%}
  </p>

  <p class="pub-venue">
    <span class="pub-kind">{{ kind_label }}</span>
    {%- if entry.type == 'article' and entry.journal -%}
      <cite>{{ entry.journal }}</cite>
    {%- elsif entry.type == 'inproceedings' and entry.booktitle -%}
      <cite>{{ entry.booktitle }}</cite>
    {%- elsif entry.type == 'phdthesis' -%}
      PhD thesis{% if entry.school %}, {{ entry.school }}{% endif %}
    {%- elsif entry.type == 'mastersthesis' -%}
      MSc thesis{% if entry.school %}, {{ entry.school }}{% endif %}
    {%- elsif entry.type == 'book' -%}
      {% if entry.note %}{{ entry.note }}{% else %}Book{% endif -%}
      {%- if entry.publisher %}, {{ entry.publisher }}{% endif %}
    {%- elsif entry.howpublished -%}
      {{ entry.howpublished }}
    {%- elsif entry.note -%}
      {{ entry.note }}
    {%- endif -%}
    {%- if include.show_year or page.show_pub_year -%}
      , <span class="num">{{ entry.year }}</span>
    {%- endif -%}
    {%- assign badge = site.data.research.badges[entry.key] -%}
    {%- if badge.core %}
      <span class="pub-badge is-core" title="{{ badge.core_venue }}: rank {{ badge.core }} in {{ badge.core_edition }}, the edition in force when the paper appeared">CORE {{ badge.core }}</span>
    {%- endif -%}
    {%- if badge.student %}
      <span class="pub-badge is-student" title="First author: {{ badge.student }}, Adaptive AI Lab">Student-led</span>
    {%- endif -%}
  </p>

  <div class="pub-actions">
    {%- if entry.abstract -%}
      <button class="pub-toggle" type="button" aria-expanded="false" aria-controls="abs-{{ entry.key }}">Abstract</button>
    {%- endif -%}
    <button class="pub-toggle" type="button" aria-expanded="false" aria-controls="bib-{{ entry.key }}">BibTeX</button>
    {%- if entry.doi -%}
      <a href="https://doi.org/{{ entry.doi }}">DOI</a>
    {%- elsif entry.url -%}
      <a href="{{ entry.url }}">Link</a>
    {%- endif -%}
    {%- if entry.pdf -%}
      <a href="{{ entry.pdf }}">PDF</a>
    {%- endif -%}
    {%- if entry.code -%}
      <a href="{{ entry.code }}">Code</a>
    {%- endif -%}
  </div>

  {%- if entry.abstract -%}
    <div class="pub-panel" id="abs-{{ entry.key }}" hidden>{{ entry.abstract }}</div>
  {%- endif -%}
  <div class="pub-panel" id="bib-{{ entry.key }}" hidden>
    <pre>{{ entry.bibtex | clean_bibtex | xml_escape }}</pre>
    <button class="copy-button" type="button" data-copy="bib-{{ entry.key }}">Copy BibTeX</button>
  </div>
</article>
