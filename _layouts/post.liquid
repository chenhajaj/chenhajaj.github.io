---
layout: default
---
<div class="wrap">
  <article class="note-body">
    <header class="note-head">
      <a class="crumb" href="{{ '/news/' | relative_url }}">News</a>
      <p class="meta">
        <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%-d %B %Y' }}</time>
      </p>
      {% if page.title and page.inline != true %}
        <h1>{{ page.title }}</h1>
      {% endif %}
    </header>
    <div class="prose">
      {{ content | strip_emoji }}
    </div>
  </article>
</div>
