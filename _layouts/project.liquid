---
layout: default
---
{%- assign slug = page.url | split: '/' | last -%}
{%- assign line = site.data.research.by_project[slug] -%}
{%- assign key = line.key | default: 'other' -%}
<section class="atlas project-hero" aria-labelledby="project-title" style="--c: var(--line-{{ key }}-bright)">
  <div class="wrap">
    <div class="project-hero-grid">
      <div class="project-hero-text">
        <a class="crumb" href="{{ '/projects/' | relative_url }}">Research</a>
        <h1 id="project-title">{{ page.title }}</h1>
        <p class="lead">{{ page.description }}</p>
        {% if page.outcome %}
          <p class="headline-result"><strong>Headline result:</strong> {{ page.outcome | escape }}.</p>
        {% endif %}
        {%- if line %}
          <dl class="atlas-stats project-stats">
            <div>
              <dt>Papers</dt>
              <dd class="num" data-count="{{ line.count }}">{{ line.count }}</dd>
            </div>
            <div>
              <dt>Years</dt>
              <dd class="num">{{ line.first }}–{{ line.last }}</dd>
            </div>
            <div>
              <dt>Co-authors</dt>
              <dd class="num" data-count="{{ line.coauthors }}">{{ line.coauthors }}</dd>
            </div>
          </dl>
        {%- endif %}
      </div>
      {%- if page.img -%}
        <div class="project-hero-img" style="view-transition-name: line-{{ slug }}">
          {% include figure.liquid path=page.img alt="" sizes="(max-width: 860px) 92vw, 520px" loading="eager" %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<div class="wrap">
  <section class="band" aria-labelledby="overview">
    <div class="band-head">
      <h2 id="overview">Overview</h2>
    </div>
    <div class="band-body prose project-prose">
      {{ content }}
    </div>
  </section>

  {%- assign line_ex = site.data.research.explainers | where: 'line', key %}
  {%- if line_ex.size > 0 %}
    <section class="band" aria-labelledby="plain">
      <div class="band-head">
        <h2 id="plain">In plain words</h2>
        <p>Explainers of this line's papers for readers outside the field.</p>
      </div>
      <div class="band-body">
        {% include explainer_cards.liquid line=key %}
      </div>
    </section>
  {%- endif %}

  {%- if line and site.data.charts.line_people[key].people.size > 0 %}
    <section class="band" aria-labelledby="line-people">
      <div class="band-head">
        <h2 id="line-people">People on this line</h2>
        {%- assign lpd = site.data.charts.line_people[key] %}
        <p>The {{ lpd.people.size }} most frequent of {{ lpd.total }} co-authors on this line since {{ line.first }}.</p>
      </div>
      <div class="band-body">
        {% include line_people.liquid key=key %}
      </div>
    </section>
  {%- endif %}

  {% if page.papers_query %}
    <section class="band" aria-labelledby="papers">
      <div class="band-head">
        <h2 id="papers">Papers</h2>
        <p>{% bibliography_count -f papers -q {{ page.papers_query }} %} publications, newest first.</p>
        <p><a href="{{ '/publications/' | relative_url }}?line={{ key }}">Search and filter them on Publications</a></p>
      </div>
      <div class="band-body pub-list">
        {%- comment -%}
          Under the "Papers" h2, years become h3 and paper titles h4, so the
          page outline stays in order (the Publications page keeps h2/h3).
        {%- endcomment -%}
        {%- capture line_bib -%}{% bibliography -f papers -q {{ page.papers_query }} --group_by year --group_order descending %}{%- endcapture -%}
        {{ line_bib
          | replace: '<h3 class="pub-title">', '<h4 class="pub-title">'
          | replace: '</h3>', '</h4>'
          | replace: '<h2 class="bibliography">', '<h3 class="bibliography">'
          | replace: '</h2>', '</h3>'
        }}
      </div>
    </section>
  {% endif %}

  <section class="band" aria-labelledby="collaborate">
    <div class="band-head">
      <h2 id="collaborate">Work on this</h2>
    </div>
    <div class="band-body">
      {%- assign line_topics = site.data.open_topics | where: 'line', key %}
      <p class="prose-block">
        The lab takes PhD and MSc students on this line and works with academic and industry partners.
        {% if line_topics.size == 1 %}This topic is open now.{% elsif line_topics.size > 1 %}These topics are open now.{% endif %} Write with a short note on your background and what you would like to work on.
      </p>
      {%- if line_topics.size > 0 %}
        <div class="topics-wrap">
          <ul class="topics">
            {%- for topic in line_topics %}
              {%- capture subject -%}PhD or MSc topic: {{ topic.title }}{%- endcapture -%}
              <li style="--c: var(--line-{{ key }})">
                <strong>{{ topic.title }}</strong>
                <span>{{ topic.text }}</span>
                <a class="topic-mail" href="mailto:chenha@g.ariel.ac.il?subject={{ subject | url_encode | replace: '+', '%20' }}"
                  >Email about this topic<span class="visually-hidden">: {{ topic.title }}</span></a
                >
              </li>
            {%- endfor %}
          </ul>
        </div>
      {%- endif %}
      <div class="actions">
        <a class="button" href="mailto:chenha@g.ariel.ac.il?subject={{ page.title | uri_escape }}">Email Chen about this line</a>
        <a class="button button-quiet" href="{{ '/software/' | relative_url }}">Code and datasets</a>
      </div>
    </div>
  </section>
</div>
