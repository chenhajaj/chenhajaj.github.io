---
layout: default
---
{%- assign slug = page.url | split: '/' | last -%}
<div class="wrap">
  <article>
    <header class="note-head">
      <a class="crumb" href="{{ '/insights/' | relative_url }}">Explainers</a>
      <p class="meta">
        {{ page.topic }}, <time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: '%B %Y' }}</time>
      </p>
      <h1>{{ page.title }}</h1>
    </header>
    <div class="note-body tracing">
      <div class="prose">
        {{ content }}
      </div>
      {% if page.links %}
        <ul class="inline-links note-links">
          {% for link in page.links %}
            <li>
              <a href="{{ link.url | relative_url }}">{{ link.label }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </article>
</div>
