---
layout: default
---
{%- assign slug = page.url | split: '/' | last -%}
<div class="wrap">
  <article>
    <header class="note-head">
      <a class="crumb" href="{{ '/insights/' | relative_url }}">Explainers</a>
      <p class="meta">
        {{ page.topic }}, <time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: '%B %Y' }}</time>
      </p>
      <h1>{{ page.title }}</h1>
    </header>
    <div class="note-body tracing">
      {%- comment -%}
        One figure per explainer, chosen by `figure:` in its front matter.
        Listed explicitly (no dynamic include path); add a line per new figure.
      {%- endcomment -%}
      {%- case page.figure %}
        {%- when 'captcha' %}
          {% include figures/captcha.liquid %}
        {%- when 'cbr' %}
          {% include figures/cbr.liquid %}
        {%- when 'coldstart' %}
          {% include figures/coldstart.liquid %}
        {%- when 'critique' %}
          {% include figures/critique.liquid %}
        {%- when 'deployable' %}
          {% include figures/deployable.liquid %}
        {%- when 'pqc' %}
          {% include figures/pqc.liquid %}
        {%- when 'rejection' %}
          {% include figures/rejection.liquid %}
        {%- when 'shared_problem' %}
          {% include figures/shared_problem.liquid %}
        {%- when 'winner' %}
          {% include figures/winner.liquid %}
      {%- endcase %}
      <div class="prose">
        {{ content }}
      </div>
      {% if page.links %}
        <ul class="inline-links note-links">
          {% for link in page.links %}
            <li>
              <a href="{{ link.url | relative_url }}">{{ link.label }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </article>
</div>
