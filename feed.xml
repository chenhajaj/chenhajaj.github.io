---
layout: null
permalink: /feed.xml
sitemap: false
---
{%- comment -%}
  Atom feed of lab news and research notes. Written by hand because
  jekyll-feed only lists _posts, and this site keeps news in the `news`
  collection and notes as pages with `layout: note`. jekyll-feed skips
  feed.xml when this file exists. Browsers show it through assets/feed.xsl.
{%- endcomment -%}
{%- assign notes = site.pages | where: 'layout', 'note' -%}
{%- assign items = site.news | concat: notes | sort: 'date' | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="{{ '/assets/feed.xsl' | relative_url }}"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>News and research notes from Chen Hajaj and the Adaptive AI Lab, Ariel University.</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="en"/>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ items.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>Chen Hajaj</name><uri>{{ '/' | absolute_url }}</uri></author>
  <icon>{{ '/assets/img/favicon.svg' | absolute_url }}</icon>
  {%- for item in items limit: 40 %}
    {%- if item.layout == 'note' -%}
      {%- assign kind = 'Explainer' -%}
      {%- assign entry_title = item.title -%}
      {%- assign entry_html = item.summary | default: item.description | markdownify -%}
    {%- else -%}
      {%- assign kind = 'News' -%}
      {%- assign entry_title = item.content | strip_html | strip_newlines | strip_emoji | strip | truncatewords: 16 -%}
      {%- assign entry_title = entry_title | replace: '&amp;', '&' | replace: '&#8217;', '’' | replace: '&#8216;', '‘' | replace: '&#8220;', '“' | replace: '&#8221;', '”' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&#8212;', '—' | replace: '&#8211;', '–' -%}
      {%- assign entry_html = item.content | strip_emoji | strip -%}
    {%- endif %}
  <entry>
    <title type="text">{{ entry_title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ item.url | absolute_url }}</id>
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    <category term="{{ kind }}"/>
    <content type="html">{{ entry_html | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
